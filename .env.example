# PulseLive backend environment
# Copy this file to .env and fill in real values. Do not commit .env.

# Server
SERVER_PORT=9000

# MySQL
DB_USERNAME=root
DB_PASSWORD=
DB_URL=jdbc:mysql://localhost:3306/ant-live?characterEncoding=utf-8&serverTimezone=GMT%2b8

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# Mail
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_PROTOCOL=smtps
MAIL_USERNAME=
MAIL_PASSWORD=

# Tencent SMS
TENCENT_SMS_APPID=
TENCENT_SMS_APP_KEY=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_TEMPLATE_NOTICE_ID=
TENCENT_SMS_SIGN=

# Tencent Live/COS
TENCENT_LIVE_DOMAIN=live.imhtb.cn
TENCENT_PLAY_DOMAIN=play.imhtb.cn
TENCENT_LIVE_APP_NAME=live
TENCENT_LIVE_SECRET_ID=
TENCENT_LIVE_SECRET_KEY=
TENCENT_LIVE_SAFE_URL_KEY=
TENCENT_COS_BUCKET_NAME=
TENCENT_COS_PATH=

# Aliyun SMS
ALIYUN_SMS_ENABLED=true
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# Alipay
ALIPAY_ENABLED=false
ALIPAY_VERIFY_SIGN=true
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=http://localhost:5174/#/center/dollar/wallet
ALIPAY_SYNC_RETURN_URL=
ALIPAY_SUBJECT_PREFIX=PulseLive recharge
ALIPAY_STATIC_PATH=

# Local LAL live service
LAL_SECRET=local-pulselive
LAL_RTMP_PUSH_STREAM=rtmp://127.0.0.1:1935/live/
LAL_FLV_PULL_STREAM=http://127.0.0.1:8080/live/
LAL_HLS_PULL_STREAM=http://127.0.0.1:8080/live/

# Live guard service
GUARD_ENABLED=true
GUARD_ENDPOINT=http://localhost:8000/check
GUARD_INTERVAL_SECONDS=2

# MinIO and file storage
MINIO_ENDPOINT=
MINIO_IP=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=live.file.bucket
MINIO_DOMAIN=http://localhost:9000/live.file.bucket/
FILE_STORAGE_MINIO_ENABLED=false

# Local startup scripts
PULSELIVE_LOCAL_SERVICES_ENABLED=true
PULSELIVE_LOCAL_LIVE_SERVICE=local-live
PULSELIVE_DENOISE_SERVICE=maxine-denoise
PULSELIVE_GUARD_SERVICE=live-guard
PULSELIVE_LOCAL_LIVE_RTMP_PORT=1935
PULSELIVE_LOCAL_LIVE_HTTP_PORT=8080

# Development fallback
VERIFY_CODE_LOCAL_MAIL_FALLBACK=true
